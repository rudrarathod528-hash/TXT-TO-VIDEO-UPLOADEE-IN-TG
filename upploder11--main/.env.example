# ==============================================
# TXT-TO-VIDEO BOT — Credentials (environment variables)
# ==============================================
# In sab ko apni values se replace karo.
# Local run:  is file ko .env bana lo ya `export VAR=value` karo
# Render/Heroku/Koyeb: "Environment Variables" section me ye add karo

# ---------- 1. TELEGRAM BOT TOKEN (ZAROORI) ----------
# @BotFather se bot banao -> /newbot -> milne wala token yahan daalo
BOT_TOKEN=1234567890:AAExampleTokenFromBotFather

# ---------- 2. TELEGRAM API ID & HASH (ZAROORI) ----------
# https://my.telegram.org -> API development tools -> App api_id & api_hash
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# ---------- 3. MONGODB DATABASE (ZAROORI - auth system ke liye) ----------
# https://www.mongodb.com/atlas -> free cluster banao
# -> Database Access me user/password banao
# -> Network Access me 0.0.0.0/0 allow karo
# -> Connect -> Drivers -> connection string yahan daalo
DATABASE_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=TXT_VIDEO_BOT

# ---------- 4. OWNER / ADMIN ----------
# Apna Telegram user ID (numeric). @userinfobot se pata karo
OWNER_ID=123456789
# Extra admins (space se alag karo) - optional
ADMINS=123456789 987654321

# ---------- 5. CAPTION CREDIT (optional) ----------
# Video caption me jo naam aayega
CREDIT=𝐈𝐓'𝐬𝐆𝐎𝐋𝐔

# ---------- 6. PW TOKEN (optional, sirf PW links ke liye) ----------
# PhysicsWallah links handle karne ke liye, nahi to khali chhodo
PW_TOKEN=

# ---------- 7. DEFAULT THUMBNAIL (optional) ----------
# Default thumbnail image URL (space separated multiple allowed)
THUMBNAILS=
